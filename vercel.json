{
  "buildCommand": "npm run build --configuration=production",
  "outputDirectory": "dist/travner-web-frontend/browser",
  "installCommand": "npm ci",
  "framework": "angular",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://travner-web-backend-production.up.railway.app/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
